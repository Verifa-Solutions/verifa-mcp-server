{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Verifa-Solutions/verifa",
  "title": "Verifa",
  "description": "Identity verification, document checks, sanctions/PEP screening and case review as agent tools.",
  "repository": {
    "url": "https://github.com/Verifa-Solutions/verifa-mcp-server",
    "source": "github"
  },
  "websiteUrl": "https://withverifa.com",
  "version": "0.1.1",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://api.withverifa.com/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@verifasolutionsinc/mcp-server",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "VERIFA_API_KEY",
          "description": "Verifa API key (vk_sandbox_... or vk_live_...)",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "VERIFA_ENV",
          "description": "sandbox or live (inferred from the key if omitted)",
          "isRequired": false
        }
      ]
    }
  ]
}
