# Sandbox API key from https://app.withverifa.com → Developers → API keys.
# Sandbox keys start with vk_sandbox_ and never touch real data.
VERIFA_API_KEY=vk_sandbox_...

# sandbox | live  (must match the key's environment)
VERIFA_ENV=sandbox

# Optional overrides
# VERIFA_API_URL=https://api.withverifa.com
# VERIFA_MCP_TOOLSETS=sessions,checks,identities,lists,workflows,org
# VERIFA_MCP_READ_ONLY=0
# VERIFA_MCP_ALLOW_DESTRUCTIVE=0
